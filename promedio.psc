Algoritmo promedio
	Definir n1, n2, n3 Como Real
	Escribir 'Ingrese nota 1: '
	Leer n1
	Escribir 'Ingrese nota 2: '
	Leer n2
	Escribir 'Ingrese nota 3: '
	Leer n3
	
Mientras n1 < 0
	Escribir 'Ingrese una nota 1 valida' 
	leer n1
FinMientras
	
Mientras n2 < 0
	Escribir 'Ingrese una nota 2 valida' 
	leer n2
FinMientras

Mientras n3 < 0
	Escribir 'Ingrese una nota 3 valida' 
	leer n3
FinMientras

Escribir 'Promedio ' (n1 + n2 + n3) / 3
	
		
FinAlgoritmo